[
  {
    "label": "Markdown Preview",
    "command": "node",
    "args": [
      "scripts/markdown-preview/server.mjs",
      "--file",
      "$ZED_FILE",
      "--root",
      "$ZED_WORKTREE_ROOT"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "allow_concurrent_runs": false,
    "use_new_terminal": false,
    "reveal": "never"
  }
]
